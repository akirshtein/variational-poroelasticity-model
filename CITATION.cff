    given-names: James H.
    orcid: "https://orcid.org/0000-0002-6603-8840"
    affiliation: "Department of Mathematics, Tufts University"
  - family-names: Hu
    given-names: Xiaozhe
    orcid: "https://orcid.org/0000-0001-7533-0416"
    affiliation: "Department of Mathematics, Tufts University"
  - family-names: Kirshtein
    given-names: Arkadz
    orcid: "https://orcid.org/0000-0002-1205-3359"
    affiliation: "Department of Mathematics & Statistics, Texas A&M University -- Corpus Christi"

